# Optional: GitHub personal access token.
# Copy this file to .env and fill in your token to raise the rate limit
# from 60 to 5,000 requests/hour. Leave it out entirely to run unauthenticated.
GITHUB_API_KEY=ghp_your_token_here

# Optional: GitLab personal access token (requires 'read_api' scope).
GITLAB_API_KEY=glpat-your_token_here
